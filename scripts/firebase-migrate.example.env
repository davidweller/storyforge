# Copy these lines into .env.local at the repo root, then run: npm run migrate:firebase
#
# Easiest: path to the service account JSON from Firebase Console
# (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional — default is ./.data next to the repo (same as dev StoryForge)
# STORYFORGE_DATA_DIR=

# Alternative: inline PEM credentials (no JSON file)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
