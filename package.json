{
  "name": "storyforge",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.js",
    "electron:build:win": "npm run build && electron-builder --win --config electron-builder.config.js",
    "migrate:firebase": "node scripts/migrate-from-firebase.js",
    "rebuild:sqlite-node": "node scripts/rebuild-better-sqlite3.cjs",
    "postinstall": "electron-builder install-app-deps && node scripts/rebuild-better-sqlite3.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@tiptap/extension-bubble-menu": "^3.18.0",
    "@tiptap/extension-floating-menu": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "file-saver": "^2.0.5",
    "next": "16.1.6",
    "openai": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-admin": "^13.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.4"
  }
}
