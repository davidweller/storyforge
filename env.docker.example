# storyforge.env — secrets for the containerised deployment.
#
#   cp env.docker.example storyforge.env
#   chmod 600 storyforge.env
#
# docker-compose.yml reads this via env_file. It is excluded by .dockerignore
# and .gitignore — keys are never baked into the image.
#
# IMPORTANT: set the keys HERE, not in the app's Settings screen. POST
# /api/settings writes <dataDir>/settings.json and mutates process.env in the
# running process, but only electron/main.js ever re-reads that file at boot.
# In a container, keys saved through the UI work until the next restart and
# then silently vanish.

# --- Required ---------------------------------------------------------------

# Drafting and editorial (the expensive path). Effectively required.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Research, planning, editorial packaging, and ALL image generation
# (gpt-image-2 for covers and A+ content).
OPENAI_API_KEY=sk-your_openai_api_key

# --- Optional providers -----------------------------------------------------

# Only needed if you select an OpenRouter model. Note that
# getProviderForModel() falls back to 'openrouter' for any unrecognised model
# id, so a typo in a model name lands here.
# OPENROUTER_API_KEY=sk-or-your_openrouter_api_key
# OPENROUTER_QWEN_FALLBACK_MODELS=qwen/qwen3.6-plus:free,qwen/qwen3-235b-a22b

# Second-tier fallback used when OpenRouter fails.
# ALIBABA_MODEL_STUDIO_API_KEY=your_alibaba_model_studio_key
# ALIBABA_MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ALIBABA_MODEL_STUDIO_MODEL=qwen-plus-latest

# --- Tuning -----------------------------------------------------------------
# These have working defaults in docker-compose.yml; override here only if
# needed. Documented in code but missing from env.example.

# Where the SQLite database, settings.json and the usage-fallback ledger live.
# Set by the compose file to /data (the volume mount). Changing it here will
# move your database — don't, unless you mean it.
# STORYFORGE_DATA_DIR=/data

# Standalone server binding. HOSTNAME must be 0.0.0.0 inside a container.
# PORT=3000
# HOSTNAME=0.0.0.0

# Requests per minute per IP against /api/*. Default 120. Note this is the ONLY
# protection the app has, it is in-memory (resets on restart), and it keys off
# x-forwarded-for, which a client can spoof. It is not authentication.
# API_RATE_LIMIT_MAX=120

# Anthropic SDK timeout in ms, minimum 60000. Default 3600000 (1 hour).
# ANTHROPIC_TIMEOUT_MS=3600000

# OpenAI image generation timeout in ms. Default 270000; values under 10000 are
# ignored. Raise if full-quality 1024x1536 covers time out on a slow line.
# OPENAI_IMAGE_TIMEOUT_MS=270000

# Prompt caching (native Anthropic Messages API only). Set to 0 to disable all.
# ANTHROPIC_PROMPT_CACHING=1
# ANTHROPIC_PROMPT_CACHING_DRAFTING=1
# ANTHROPIC_PROMPT_CACHING_EDITORIAL=0
# ANTHROPIC_CACHE_MIN_INPUT_TOKENS=1024

# Style guide named in the copy-edit prompts.
# COPY_EDIT_STYLE_GUIDE=Chicago Manual of Style (17th ed.)

# --- Deliberately absent ----------------------------------------------------
#
# ALLOWED_EMAILS   — appears in env.example under "Authentication Allowlist"
#                    and is referenced by zero lines of code. It enforces
#                    nothing. Access control is Tailscale, not this.
# NEXT_PUBLIC_APP_URL — declared in env.example, never read anywhere.
# FIREBASE_*       — the migration script only, not runtime. firebase-admin is
#                    a devDependency and is not in the image.
