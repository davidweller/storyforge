# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side only)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# LLM API Keys (Server-side only)
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Optional: Anthropic SDK request timeout in ms (min 60000). Default 3600000 (1 hour). Prevents "terminated" on long editorials.
# ANTHROPIC_TIMEOUT_MS=3600000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Allowlist
# Comma-separated list of email addresses allowed to sign up
# Example: ALLOWED_EMAILS=user1@example.com,user2@example.com,admin@example.com
ALLOWED_EMAILS=your-email@example.com

# Local development with Firebase Emulators (optional)
# Set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true to point the client at local emulators.
# When running the dev server with emulators, also set (or use npm run dev:local):
#   FIRESTORE_EMULATOR_HOST=localhost:8080
#   FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
# Do not set these in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false