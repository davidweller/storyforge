# LLM API Keys (Server-side only)
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key
# Optional: comma-separated OpenRouter fallback model list (tried on "No endpoints found")
# OPENROUTER_QWEN_FALLBACK_MODELS=qwen/qwen3.6-plus:free,qwen/qwen3-235b-a22b
# Optional: fallback provider when OpenRouter fails (Qwen-compatible OpenAI endpoint)
# ALIBABA_MODEL_STUDIO_API_KEY=your_alibaba_model_studio_key
# Optional override; default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ALIBABA_MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Optional fallback model id; default: qwen-plus-latest
# ALIBABA_MODEL_STUDIO_MODEL=qwen-plus-latest
# Optional: Anthropic SDK request timeout in ms (min 60000). Default 3600000 (1 hour). Prevents "terminated" on long editorials.
# ANTHROPIC_TIMEOUT_MS=3600000

# Prompt caching (Messages API, native Anthropic only). ANTHROPIC_PROMPT_CACHING=0 disables all.
# ANTHROPIC_PROMPT_CACHING=1
# Drafting / scene pipeline / summaries / eval — default on when global is on.
# ANTHROPIC_PROMPT_CACHING_DRAFTING=1
# Editorial reordered prompts (system canon + user manuscript) — default off; enable after QA.
# ANTHROPIC_PROMPT_CACHING_EDITORIAL=0
# Minimum estimated input tokens to attach cache_control (re-verify vs Anthropic docs when upgrading models).
# ANTHROPIC_CACHE_MIN_INPUT_TOKENS=1024

# Copy-edit pass: style guide named in prompts (default: Chicago Manual of Style 17th ed.)
# COPY_EDIT_STYLE_GUIDE=Chicago Manual of Style (17th ed.)

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Allowlist
# Comma-separated list of email addresses allowed to sign up
# Example: ALLOWED_EMAILS=user1@example.com,user2@example.com,admin@example.com
ALLOWED_EMAILS=your-email@example.com
